<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mcg.AgentOrchestrator.Dashboard</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mcg.AgentOrchestrator.App\Mcg.AgentOrchestrator.App.csproj" />
    <Compile Include="..\Mcg.AgentOrchestrator.App\Dashboard\Hosting\DashboardHost.cs" Link="Dashboard\Hosting\DashboardHost.cs" />
    <Compile Include="..\Mcg.AgentOrchestrator.App\Dashboard\Api\**\*.cs"
             Link="Dashboard\Api\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Mcg.AgentOrchestrator.App\Dashboard\Rendering\**\*.cs"
             Link="Dashboard\Rendering\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
