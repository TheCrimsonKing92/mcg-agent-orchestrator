<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Sdk.Web defaults to Server GC (per-core heaps), which commits hundreds of MB for the CLI/loop's
         small live set on a many-core box. The mostly-sequential conduct loop wants Workstation GC.
         Set here (not just DOTNET_gcServer env var) because runtimeconfig.json wins over the env var.
         (memory-efficiency expert dance 2026-07-22) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;artifacts/**;.scratch/**</DefaultItemExcludes>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/obj/**;**/artifacts/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Core\Mcg.AgentOrchestrator.Core.csproj" />
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Infrastructure\Mcg.AgentOrchestrator.Infrastructure.csproj" />
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Infrastructure.Providers\Mcg.AgentOrchestrator.Infrastructure.Providers.csproj" />
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Infrastructure.OperatorComms\Mcg.AgentOrchestrator.Infrastructure.OperatorComms.csproj" />
    <Content Include="..\..\config\trials\hermes-acp-v2026.8.27.json"
             Link="config\trials\hermes-acp-v2026.8.27.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
