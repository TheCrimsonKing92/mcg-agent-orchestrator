<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;artifacts/**;.scratch/**</DefaultItemExcludes>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/obj/**;**/artifacts/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Core\Mcg.AgentOrchestrator.Core.csproj" AdditionalProperties="DefaultItemExcludesInProjectFolder=$(DefaultItemExcludesInProjectFolder);**\obj\**;**\artifacts\**" />
    <ProjectReference Include="..\Mcg.AgentOrchestrator.Infrastructure\Mcg.AgentOrchestrator.Infrastructure.csproj" AdditionalProperties="DefaultItemExcludesInProjectFolder=$(DefaultItemExcludesInProjectFolder);**\obj\**;**\artifacts\**" />
  </ItemGroup>
</Project>
