<Project>
  <!--
    A build receipt is provenance for the adjacent output, not an authority to run it.
    It detects stale outputs; it is not intended to defend against a maliciously edited receipt.
  -->
  <Target Name="McgWriteBuildReceipt" AfterTargets="Build"
          Condition="'$(McgEmitBuildReceipt)' != 'false' and Exists('$(TargetPath)') and Exists('$(TargetDir)$(TargetName).pdb')">
    <PropertyGroup>
      <_McgReceiptPath>$(TargetDir).mcg-build-receipt.txt</_McgReceiptPath>
      <_McgReceiptTemporaryPath>$(_McgReceiptPath).tmp</_McgReceiptTemporaryPath>
      <_McgReceiptRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_McgReceiptRepositoryRoot>
    </PropertyGroup>

    <ItemGroup>
      <_McgReceiptSources Include="@(Compile)" />
      <_McgReceiptOutputFiles Include="$(TargetPath)">
        <Kind>assembly</Kind>
      </_McgReceiptOutputFiles>
      <_McgReceiptOutputFiles Include="$(TargetDir)$(TargetName).pdb">
        <Kind>pdb</Kind>
      </_McgReceiptOutputFiles>
    </ItemGroup>
    <GetFileHash Files="@(_McgReceiptSources)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_McgReceiptSourceHashes" />
    </GetFileHash>
    <GetFileHash Files="@(_McgReceiptOutputFiles)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_McgReceiptOutputHashes" />
    </GetFileHash>

    <ItemGroup>
      <_McgReceiptLines Include="K&#x9;schemaVersion&#x9;1" />
      <_McgReceiptLines Include="K&#x9;project&#x9;$(MSBuildProjectFullPath)" />
      <_McgReceiptLines Include="K&#x9;configuration&#x9;$(Configuration)" />
      <_McgReceiptLines Include="K&#x9;targetFramework&#x9;$(TargetFramework)" />
      <_McgReceiptLines Include="K&#x9;runtimeIdentifier&#x9;$(RuntimeIdentifier)" />
      <_McgReceiptLines Include="K&#x9;repositoryRoot&#x9;$(_McgReceiptRepositoryRoot)" />
      <_McgReceiptLines Include="K&#x9;outputDirectory&#x9;$(TargetDir)" />
      <_McgReceiptLines Include="K&#x9;assemblyLeaf&#x9;$(TargetFileName)" />
      <_McgReceiptLines Include="K&#x9;assemblySha256&#x9;%(_McgReceiptOutputHashes.FileHash)" Condition="'%(_McgReceiptOutputHashes.Kind)' == 'assembly'" />
      <_McgReceiptLines Include="K&#x9;pdbSha256&#x9;%(_McgReceiptOutputHashes.FileHash)" Condition="'%(_McgReceiptOutputHashes.Kind)' == 'pdb'" />
      <_McgReceiptLines Include="S&#x9;source&#x9;%(_McgReceiptSourceHashes.FullPath)&#x9;%(_McgReceiptSourceHashes.FileHash)" />
    </ItemGroup>

    <WriteLinesToFile File="$(_McgReceiptTemporaryPath)" Lines="@(_McgReceiptLines)" Overwrite="true" Encoding="UTF-8" />
    <Move SourceFiles="$(_McgReceiptTemporaryPath)" DestinationFiles="$(_McgReceiptPath)" />
  </Target>
</Project>
