using System.Security;

if (args.Length != 7 ||
    !args[0].Equals("--results-directory", StringComparison.Ordinal) ||
    !args[2].Equals("--report-trx", StringComparison.Ordinal) ||
    !args[3].Equals("--report-trx-filename", StringComparison.Ordinal) ||
    !args[5].Equals("--filter-class", StringComparison.Ordinal) ||
    !args[6].Contains("CanaryTests", StringComparison.Ordinal))
{
    Console.Error.WriteLine(
        "Known-green canary received arguments outside the strict MTP contract: " +
        string.Join(' ', args));
    return 2;
}

var resultsDirectory = ReadValue(args, "--results-directory")
    ?? Path.Combine(Environment.CurrentDirectory, "TestResults");
var trxFileName = ReadValue(args, "--report-trx-filename") ?? "core-tests.trx";
Directory.CreateDirectory(resultsDirectory);
var trxPath = Path.Combine(resultsDirectory, trxFileName);
const string testId = "a82a00e4-0e82-4c59-843b-a70bd036fbf1";
var started = DateTimeOffset.UtcNow;
var completed = started.AddMilliseconds(1);
var trx = $"""
    <?xml version="1.0" encoding="utf-8"?>
    <TestRun id="{Guid.NewGuid()}" name="MCG post-landing canary" xmlns="http://microsoft.com/schemas/VisualStudio/TeamTest/2010">
      <Times creation="{started:O}" start="{started:O}" finish="{completed:O}" />
      <Results>
        <UnitTestResult executionId="{Guid.NewGuid()}" testId="{testId}" testName="CanaryTests.KnownGreen" computerName="localhost" duration="00:00:00.0010000" startTime="{started:O}" endTime="{completed:O}" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" />
      </Results>
      <TestDefinitions>
        <UnitTest name="CanaryTests.KnownGreen" storage="canary">
          <Execution id="{Guid.NewGuid()}" />
          <TestMethod codeBase="canary" adapterTypeName="canary" className="CanaryTests" name="KnownGreen" />
        </UnitTest>
      </TestDefinitions>
      <ResultSummary outcome="Completed">
        <Counters total="1" executed="1" passed="1" failed="0" error="0" timeout="0" aborted="0" inconclusive="0" passedButRunAborted="0" notRunnable="0" notExecuted="0" disconnected="0" warning="0" completed="1" inProgress="0" pending="0" />
      </ResultSummary>
    </TestRun>
    """;
File.WriteAllText(trxPath, trx);
Console.WriteLine("Passed! Failed: 0, Passed: 1, Skipped: 0, Total: 1");
return 0;

static string? ReadValue(string[] arguments, string name)
{
    for (var index = 0; index < arguments.Length - 1; index++)
    {
        if (arguments[index].Equals(name, StringComparison.OrdinalIgnoreCase))
        {
            return SecurityElement.Escape(arguments[index + 1]) is { } escaped
                ? System.Net.WebUtility.HtmlDecode(escaped)
                : arguments[index + 1];
        }
    }

    return null;
}
