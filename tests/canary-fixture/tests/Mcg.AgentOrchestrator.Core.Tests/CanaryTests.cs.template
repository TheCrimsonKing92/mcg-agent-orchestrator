using System.Security;

if (!TryReadRequiredValue(args, "--results-directory", out var resultsDirectory, out var resultsDirectoryFailure))
{
    Console.Error.WriteLine(
        $"Known-green canary is missing a required argument value: --results-directory {resultsDirectoryFailure}. " +
        $"Received: {FormatArguments(args)}");
    return 2;
}

if (!TryReadRequiredValue(args, "--report-trx-filename", out var trxFileName, out var trxFileNameFailure))
{
    Console.Error.WriteLine(
        $"Known-green canary is missing a required argument value: --report-trx-filename {trxFileNameFailure}. " +
        $"Received: {FormatArguments(args)}");
    return 2;
}

Directory.CreateDirectory(resultsDirectory);
var trxPath = Path.Combine(resultsDirectory, trxFileName);
const string testId = "a82a00e4-0e82-4c59-843b-a70bd036fbf1";
var started = DateTimeOffset.UtcNow;
var completed = started.AddMilliseconds(1);
var trx = $"""
