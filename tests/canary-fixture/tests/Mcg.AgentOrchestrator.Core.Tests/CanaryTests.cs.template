static bool TryReadRequiredValue(
    string[] arguments,
    string name,
    out string value,
    out string failure)
{
    for (var index = 0; index < arguments.Length; index++)
    {
        if (arguments[index].Equals(name, StringComparison.OrdinalIgnoreCase))
        {
            if (index == arguments.Length - 1 ||
                string.IsNullOrWhiteSpace(arguments[index + 1]) ||
                arguments[index + 1].StartsWith("--", StringComparison.Ordinal))
            {
                value = string.Empty;
                failure = "had no value";
                return false;
            }

            value = SecurityElement.Escape(arguments[index + 1]) is { } escaped
                ? System.Net.WebUtility.HtmlDecode(escaped)
                : arguments[index + 1];
            failure = string.Empty;
            return true;
        }
    }

    value = string.Empty;
    failure = "was not supplied";
    return false;
}

static string FormatArguments(string[] arguments)
    => arguments.Length == 0 ? "<none>" : string.Join(' ', arguments);
